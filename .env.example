# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 깃과 제출 zip에 넣지 않습니다.
# 키를 비워 두어도 앱은 끝까지 동작합니다(기본 대본 · 질문 목록 · 컴퓨터 내장 음성).

# Claude — 각색 대본 만들기, 직접 질문 답하기 (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# ElevenLabs — 아바타·인터뷰어 목소리, 말로 한 질문 알아듣기 (https://elevenlabs.io)
ELEVENLABS_API_KEY=

# 목소리 ID (비우면 ElevenLabs 기본 목소리. Voice Library에서 고른 ID로 바꿀 수 있음)
VOICE_AVATAR=
VOICE_INTERVIEWER=

# 사이트 자료를 실시간으로 읽을 Supabase 공개(publishable) 키. 비우면 동봉 스냅숏 사용
SUPABASE_URL=
SUPABASE_KEY=

# 모델 바꾸기 (선택)
# CLAUDE_SCRIPT_MODEL=claude-sonnet-5-5
# CLAUDE_ANSWER_MODEL=claude-haiku-5-5
